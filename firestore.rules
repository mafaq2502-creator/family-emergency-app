rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function userPath(userId) {
      return /databases/$(database)/documents/users/$(userId);
    }

    function isPremiumUser(userId) {
      return signedIn() && exists(userPath(userId)) &&
        get(userPath(userId)).data.get('planTier', 'free') == 'premium' &&
        get(userPath(userId)).data.get('subscriptionStatus', '') == 'active';
    }

    function group(groupId) {
      return get(groupPath(groupId));
    }

    function groupAfter(groupId) {
      return getAfter(groupPath(groupId));
    }

    function invitePath(inviteId) {
      return /databases/$(database)/documents/circleInvites/$(inviteId);
    }

    function invite(inviteId) {
      return get(invitePath(inviteId));
    }

    function joinRequestPath(groupId, userId) {
      return /databases/$(database)/documents/groups/$(groupId)/joinRequests/$(userId);
    }

    function isMember(groupId) {
      return signedIn() &&
        (!('status' in group(groupId).data) || group(groupId).data.status == 'active') &&
        request.auth.uid in group(groupId).data.memberIds;
    }

    function role(groupId) {
      return group(groupId).data.roles[request.auth.uid];
    }

    function isOwner(groupId) {
      return isMember(groupId) && role(groupId) == 'owner';
    }

    function isCircleManager(groupId) {
      // 'admin' is accepted temporarily for existing Circle documents.
      return isMember(groupId) && role(groupId) in ['owner', 'parent', 'admin'];
    }

    function validGroupCreate() {
      return request.resource.data.keys().hasAll([
          'name', 'ownerId', 'memberIds', 'roles',
          'emergencyRecipientIds', 'status', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid] &&
        request.resource.data.roles[request.auth.uid] == 'owner' &&
        request.resource.data.emergencyRecipientIds == [request.auth.uid] &&
        request.resource.data.status == 'active';
    }

    function validActiveInvite(groupId, inviteId) {
      return inviteId is string &&
        invite(inviteId).data.circleId == groupId &&
        invite(inviteId).data.status == 'active' &&
        invite(inviteId).data.requiresApproval == true &&
        invite(inviteId).data.expiresAt is timestamp &&
        invite(inviteId).data.expiresAt > request.time &&
        invite(inviteId).data.maxUses is int &&
        invite(inviteId).data.useCount is int &&
        invite(inviteId).data.useCount < invite(inviteId).data.maxUses;
    }

    function validJoinRequest(groupId, userId) {
      return request.resource.data.keys().hasAll([
          'circleId', 'userUid', 'inviteId', 'displayName', 'email',
          'relationship', 'circleRole', 'status', 'requestedAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'circleId', 'userUid', 'inviteId', 'displayName', 'email',
          'relationship', 'circleRole', 'status', 'requestedAt', 'updatedAt'
        ]) &&
        request.resource.data.circleId == groupId &&
        request.resource.data.userUid == userId &&
        request.resource.data.userUid == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.circleRole in ['adult', 'child'] &&
        request.resource.data.requestedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (!('status' in group(groupId).data) || group(groupId).data.status == 'active') &&
        !(request.auth.uid in group(groupId).data.memberIds) &&
        validActiveInvite(groupId, request.resource.data.inviteId);
    }

    function validApprovalGroupUpdate(groupId) {
      let userId = request.resource.data.lastApprovedUserId;
      return userId is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberIds', 'roles', 'lastApprovedUserId', 'updatedAt'
        ]) &&
        !(userId in resource.data.memberIds) &&
        userId in request.resource.data.memberIds &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
        resource.data.memberIds.hasOnly(request.resource.data.memberIds) &&
        request.resource.data.roles.diff(resource.data.roles).affectedKeys().hasOnly([userId]) &&
        request.resource.data.roles[userId] in ['adult', 'child'] &&
        getAfter(joinRequestPath(groupId, userId)).data.status == 'approved' &&
        getAfter(joinRequestPath(groupId, userId)).data.reviewedBy == request.auth.uid;
    }

    function validOwnerCircleDeletion(groupId) {
      return isOwner(groupId) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'deleted' &&
        request.resource.data.deletedBy == request.auth.uid &&
        request.resource.data.deletedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.memberIds == [] &&
        request.resource.data.roles == {} &&
        request.resource.data.emergencyRecipientIds == [] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'deletedBy', 'deletedAt', 'memberIds', 'roles',
          'emergencyRecipientIds', 'updatedAt'
        ]);
    }

    function ownerDeletingCircle(groupId) {
      return isOwner(groupId) && group(groupId).data.ownerId == request.auth.uid &&
        groupAfter(groupId).data.status == 'deleted' &&
        groupAfter(groupId).data.deletedBy == request.auth.uid;
    }

    function deletionRevokesInvite(groupId) {
      return ownerDeletingCircle(groupId) &&
        request.resource.data.status == 'revoked' &&
        request.resource.data.revokedBy == request.auth.uid &&
        request.resource.data.revokedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'revokedBy', 'revokedAt', 'updatedAt'
        ]);
    }

    function deletionUnpairsDevice(groupId) {
      return ownerDeletingCircle(groupId) &&
        request.resource.data.pairingStatus == 'unpaired' &&
        request.resource.data.removedBy == request.auth.uid &&
        request.resource.data.removedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pairingStatus', 'removedBy', 'removedAt', 'updatedAt'
        ]);
    }

    function validMembershipCircleDeletion(groupId) {
      return isOwner(groupId) &&
        groupAfter(groupId).data.status == 'deleted' &&
        groupAfter(groupId).data.deletedBy == request.auth.uid &&
        request.resource.data.status == 'removed' &&
        request.resource.data.endedBy == request.auth.uid &&
        request.resource.data.endedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'endedBy', 'endedAt', 'updatedAt'
        ]);
    }

    function approvedMembershipWrite(groupId, userId) {
      let requestAfter = getAfter(joinRequestPath(groupId, userId));
      return isCircleManager(groupId) &&
        groupAfter(groupId).data.lastApprovedUserId == userId &&
        requestAfter.data.status == 'approved' &&
        requestAfter.data.reviewedBy == request.auth.uid &&
        request.resource.data.userId == userId &&
        request.resource.data.status == 'active' &&
        request.resource.data.circleRole in ['adult', 'child'];
    }

    function approvedProfileUpdate(userId) {
      let groupId = request.resource.data.activeCircleId;
      let requestAfter = getAfter(joinRequestPath(groupId, userId));
      return groupId is string &&
        isCircleManager(groupId) &&
        requestAfter.data.status == 'approved' &&
        requestAfter.data.reviewedBy == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'onboardingCompleted', 'activeCircleId', 'circleIds',
          'pendingJoinCircleId', 'pendingJoinInviteId', 'updatedAt'
        ]) &&
        groupId in request.resource.data.circleIds;
    }

    function validAddress(address) {
      return address is map &&
        address.keys().hasOnly([
          'line1', 'line2', 'city', 'region', 'postalCode', 'countryIso'
        ]) &&
        (!('line1' in address) ||
          (address.line1 is string && address.line1.size() <= 200)) &&
        (!('line2' in address) ||
          (address.line2 is string && address.line2.size() <= 200)) &&
        (!('city' in address) ||
          (address.city is string && address.city.size() <= 200)) &&
        (!('region' in address) ||
          (address.region is string && address.region.size() <= 200)) &&
        (!('postalCode' in address) ||
          (address.postalCode is string && address.postalCode.size() <= 200)) &&
        (!('countryIso' in address) ||
          (address.countryIso is string &&
           (address.countryIso == '' ||
            address.countryIso.matches('^[A-Z]{2}$'))));
    }

    function validSelfProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid', 'name', 'email', 'phone', 'phoneCountryIso',
          'phoneCountryCode', 'relationship', 'photoUrl', 'providerIds',
          'profileCompleted', 'onboardingCompleted', 'notificationSettings',
          'address', 'lastDailyCheckInAt', 'lastDailyCheckInTimeZone',
          'lastDailyCheckInLocalDate', 'lastSignInAt', 'activeCircleId',
          'circleIds', 'pendingJoinCircleId', 'pendingJoinInviteId',
          'ownedCircleIds', 'joinedCircleIds', 'planTier',
          'subscriptionStatus',
          'createdAt', 'updatedAt'
        ]) &&
        (!('uid' in request.resource.data) || request.resource.data.uid == userId) &&
        (!('email' in request.resource.data) ||
          !('email' in request.auth.token) ||
          request.resource.data.email == request.auth.token.email) &&
        (!('name' in request.resource.data) ||
          (request.resource.data.name is string &&
           request.resource.data.name.size() <= 80)) &&
        (!('phone' in request.resource.data) ||
          (request.resource.data.phone is string &&
           request.resource.data.phone.size() <= 32)) &&
        (!('relationship' in request.resource.data) ||
          request.resource.data.relationship == null ||
          request.resource.data.relationship in [
            'Self', 'Father', 'Mother', 'Son', 'Daughter', 'Husband',
            'Wife', 'Grandfather', 'Grandmother', 'Grandson',
            'Granddaughter', 'Brother', 'Sister', 'Spouse', 'Child',
            'Relative', 'Guardian', 'Other'
          ]) &&
        (!('address' in request.resource.data) ||
          validAddress(request.resource.data.address)) &&
        (!('profileCompleted' in request.resource.data) ||
          request.resource.data.profileCompleted != true ||
          (request.resource.data.name is string &&
           request.resource.data.name.size() >= 2 &&
           request.resource.data.relationship is string)) &&
        (!('planTier' in request.resource.data) ||
          request.resource.data.planTier in ['free', 'premium']) &&
        (!('subscriptionStatus' in request.resource.data) ||
          request.resource.data.subscriptionStatus in ['active', 'inactive', 'cancelled']) &&
        (resource == null ||
          request.resource.data.get('planTier', 'free') == resource.data.get('planTier', 'free')) &&
        (resource == null ||
          request.resource.data.get('subscriptionStatus', '') == resource.data.get('subscriptionStatus', '')) &&
        (resource != null ||
          (request.resource.data.get('planTier', 'free') == 'free' &&
           request.resource.data.get('subscriptionStatus', '') != 'active')) &&
        (resource == null || !('createdAt' in resource.data) ||
          request.resource.data.createdAt == resource.data.createdAt);
    }

    // Circle cleanup must not revalidate unrelated legacy profile fields.
    // Bind this exception to the owner's atomic Circle tombstone.
    function validOwnerProfileCircleDeletion(userId) {
      let removed = resource.data.circleIds.removeAll(request.resource.data.circleIds);
      let circleId = removed[0];
      return signedIn() && request.auth.uid == userId &&
        removed.size() == 1 && circleId is string && ownerDeletingCircle(circleId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'circleIds', 'activeCircleId', 'updatedAt'
        ]) &&
        ((resource.data.get('activeCircleId', '') == circleId &&
          !('activeCircleId' in request.resource.data)) ||
         (resource.data.get('activeCircleId', '') != circleId &&
          request.resource.data.get('activeCircleId', '') == resource.data.get('activeCircleId', ''))) &&
        request.resource.data.circleIds == resource.data.circleIds.removeAll([circleId]) &&
        request.resource.data.updatedAt == request.time;
    }

    function validOwnIdentitySync(userId) {
      let profileAfter = getAfter(
        /databases/$(database)/documents/users/$(userId)
      );
      return signedIn() && request.auth.uid == userId &&
        resource.data.userId == userId &&
        request.resource.data.userId == userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'relationship', 'updatedAt'
        ]) &&
        request.resource.data.displayName == profileAfter.data.name &&
        request.resource.data.relationship == profileAfter.data.relationship;
    }

    function installationPath(userId, installationId) {
      return /databases/$(database)/documents/users/$(userId)/devices/$(installationId);
    }

    function pairingPath(pairingId) {
      return /databases/$(database)/documents/devicePairingRequests/$(pairingId);
    }

    function deviceAssociationPath(groupId, associationId) {
      return /databases/$(database)/documents/groups/$(groupId)/devices/$(associationId);
    }

    function validDeviceName(name) {
      return name is string && name.size() >= 1 && name.size() <= 80;
    }

    function validDevicePlatform(platform) {
      return platform in [
        'android', 'ios', 'web', 'windows', 'macos', 'linux', 'fuchsia'
      ];
    }

    function validInstallationCreate(userId, deviceId) {
      return request.resource.data.keys().hasAll([
          'installationId', 'ownerUserId', 'name', 'platform', 'appVersion',
          'status', 'pairingStatus', 'registeredAt', 'lastSeenAt',
          'lastHeartbeatAt', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'installationId', 'ownerUserId', 'name', 'platform', 'appVersion',
          'status', 'pairingStatus', 'registeredAt', 'lastSeenAt',
          'lastHeartbeatAt', 'createdAt', 'updatedAt'
        ]) &&
        deviceId.matches('^[A-Z2-9]{32}$') &&
        request.resource.data.installationId == deviceId &&
        request.resource.data.ownerUserId == userId &&
        request.auth.uid == userId &&
        validDeviceName(request.resource.data.name) &&
        validDevicePlatform(request.resource.data.platform) &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 32 &&
        request.resource.data.status == 'active' &&
        request.resource.data.pairingStatus == 'registered' &&
        request.resource.data.registeredAt == request.time &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.lastHeartbeatAt == request.time &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    function validInstallationHeartbeat(userId, deviceId) {
      return request.auth.uid == userId &&
        resource.data.ownerUserId == userId &&
        resource.data.installationId == deviceId &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'platform', 'appVersion', 'lastSeenAt', 'lastHeartbeatAt', 'updatedAt'
        ]) &&
        validDevicePlatform(request.resource.data.platform) &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 32 &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.lastHeartbeatAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (!(resource.data.lastHeartbeatAt is timestamp) ||
          request.time >= resource.data.lastHeartbeatAt + duration.value(1, 'm'));
    }

    function validInstallationRename(userId, deviceId) {
      return request.auth.uid == userId &&
        resource.data.ownerUserId == userId &&
        resource.data.installationId == deviceId &&
        resource.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'updatedAt'
        ]) &&
        validDeviceName(request.resource.data.name) &&
        request.resource.data.updatedAt == request.time;
    }

    function validInstallationRevoke(userId, deviceId) {
      return request.auth.uid == userId &&
        resource.data.ownerUserId == userId &&
        resource.data.installationId == deviceId &&
        resource.data.status == 'active' &&
        request.resource.data.status == 'revoked' &&
        request.resource.data.pairingStatus == 'revoked' &&
        request.resource.data.revokedBy == request.auth.uid &&
        request.resource.data.revokedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'pairingStatus', 'revokedAt', 'revokedBy', 'updatedAt'
        ]);
    }

    function validPushRegistration(userId, deviceId) {
      return request.auth.uid == userId &&
        resource.data.ownerUserId == userId &&
        resource.data.installationId == deviceId &&
        resource.data.status == 'active' &&
        request.resource.data.notificationPermissionState in [
          'notRequested', 'granted', 'denied', 'settingsRequired', 'unavailable'
        ] &&
        request.resource.data.notificationsEnabled is bool &&
        request.resource.data.notificationCapable is bool &&
        request.resource.data.manufacturer is string &&
        request.resource.data.manufacturer.size() <= 100 &&
        request.resource.data.model is string &&
        request.resource.data.model.size() <= 100 &&
        request.resource.data.osVersion is string &&
        request.resource.data.osVersion.size() <= 64 &&
        request.resource.data.androidApiLevel is int &&
        request.resource.data.androidApiLevel >= 1 &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 32 &&
        request.resource.data.notificationsEnabled ==
          (request.resource.data.notificationPermissionState == 'granted') &&
        request.resource.data.appBuildNumber is string &&
        request.resource.data.appBuildNumber.size() <= 32 &&
        (!('fcmToken' in request.resource.data) ||
          (request.resource.data.fcmToken is string &&
           request.resource.data.fcmToken.size() <= 4096)) &&
        request.resource.data.pushUpdatedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcmToken', 'notificationPermissionState', 'notificationsEnabled',
          'notificationCapable', 'manufacturer', 'model', 'osVersion',
          'androidApiLevel', 'appVersion', 'appBuildNumber', 'pushUpdatedAt',
          'updatedAt'
        ]);
    }

    function validPushDetach(userId, deviceId) {
      return request.auth.uid == userId &&
        resource.data.ownerUserId == userId &&
        resource.data.installationId == deviceId &&
        !('fcmToken' in request.resource.data) &&
        request.resource.data.notificationsEnabled == false &&
        request.resource.data.pushUpdatedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'fcmToken', 'notificationsEnabled', 'pushUpdatedAt', 'updatedAt'
        ]);
    }

    function validScreenTimePermissionUpdate(userId, deviceId) {
      return request.auth.uid == userId &&
        resource.data.ownerUserId == userId &&
        resource.data.installationId == deviceId &&
        resource.data.status == 'active' &&
        request.resource.data.permissions is map &&
        request.resource.data.permissions.screenTime is bool &&
        request.resource.data.screenTimePermissionState in [
          'unknown', 'notGranted', 'granted', 'unavailable'
        ] &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'permissions', 'screenTimePermissionState', 'updatedAt'
        ]);
    }

    function validScreenTimeSyncStatus(userId, deviceId) {
      return request.auth.uid == userId &&
        resource.data.ownerUserId == userId &&
        resource.data.installationId == deviceId &&
        resource.data.status == 'active' &&
        request.resource.data.permissions is map &&
        request.resource.data.permissions.screenTime == true &&
        request.resource.data.lastScreenTimeSyncAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'permissions', 'lastScreenTimeSyncAt', 'updatedAt'
        ]);
    }

    function validScreenTimeRecord(userId, installationId, localDate) {
      return request.resource.data.keys().hasAll([
          'userId', 'installationId', 'localDate', 'timeZoneOffsetMinutes',
          'totalTimeMs', 'apps', 'collectedAt', 'syncedAt', 'source',
          'schemaVersion'
        ]) &&
        request.resource.data.keys().hasOnly([
          'userId', 'installationId', 'localDate', 'timeZoneOffsetMinutes',
          'totalTimeMs', 'apps', 'collectedAt', 'syncedAt', 'source',
          'schemaVersion'
        ]) &&
        request.auth.uid == userId &&
        request.resource.data.userId == userId &&
        request.resource.data.installationId == installationId &&
        request.resource.data.localDate == localDate &&
        localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        request.resource.data.timeZoneOffsetMinutes is int &&
        request.resource.data.timeZoneOffsetMinutes >= -840 &&
        request.resource.data.timeZoneOffsetMinutes <= 840 &&
        request.resource.data.totalTimeMs is int &&
        request.resource.data.totalTimeMs >= 0 &&
        request.resource.data.totalTimeMs <= 172800000 &&
        request.resource.data.apps is list &&
        request.resource.data.apps.size() <= 100 &&
        request.resource.data.collectedAt is timestamp &&
        request.resource.data.collectedAt <= request.time &&
        request.resource.data.syncedAt == request.time &&
        request.resource.data.source == 'android_usage_stats' &&
        request.resource.data.schemaVersion == 1;
    }

    function validCircleScreenTimeRecord(groupId, recordId) {
      let userId = request.resource.data.userId;
      let installationId = request.resource.data.installationId;
      let associationId = userId + '_' + installationId;
      let association = get(deviceAssociationPath(groupId, associationId));
      return isMember(groupId) &&
        userId == request.auth.uid &&
        userId in group(groupId).data.memberIds &&
        recordId == userId + '_' + installationId + '_' +
          request.resource.data.localDate &&
        exists(deviceAssociationPath(groupId, associationId)) &&
        association.data.ownerUserId == userId &&
        association.data.installationId == installationId &&
        association.data.pairingStatus == 'paired' &&
        validScreenTimeRecord(
          userId, installationId, request.resource.data.localDate
        );
    }

    function validPairingCreate(pairingId) {
      let installationId = request.resource.data.installationId;
      let installation = get(installationPath(request.auth.uid, installationId));
      return pairingId.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{24}$') &&
        request.resource.data.keys().hasAll([
          'ownerUserId', 'installationId', 'deviceName', 'platform',
          'appVersion', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'ownerUserId', 'installationId', 'deviceName', 'platform',
          'appVersion', 'status', 'createdAt', 'expiresAt'
        ]) &&
        request.resource.data.ownerUserId == request.auth.uid &&
        exists(installationPath(request.auth.uid, installationId)) &&
        installation.data.status == 'active' &&
        installation.data.ownerUserId == request.auth.uid &&
        installation.data.name == request.resource.data.deviceName &&
        installation.data.platform == request.resource.data.platform &&
        validDeviceName(request.resource.data.deviceName) &&
        validDevicePlatform(request.resource.data.platform) &&
        request.resource.data.appVersion is string &&
        request.resource.data.appVersion.size() <= 32 &&
        request.resource.data.status == 'active' &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(10, 'm');
    }

    function validPairingUse(pairingId) {
      let groupId = request.resource.data.circleId;
      let associationId = request.resource.data.deviceAssociationId;
      let association = getAfter(deviceAssociationPath(groupId, associationId));
      return resource.data.status == 'active' &&
        resource.data.expiresAt > request.time &&
        isCircleManager(groupId) &&
        resource.data.ownerUserId in group(groupId).data.memberIds &&
        existsAfter(deviceAssociationPath(groupId, associationId)) &&
        association.data.ownerUserId == resource.data.ownerUserId &&
        association.data.installationId == resource.data.installationId &&
        association.data.pairingRequestId == pairingId &&
        association.data.pairingStatus == 'paired' &&
        request.resource.data.status == 'used' &&
        request.resource.data.usedAt == request.time &&
        request.resource.data.usedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'usedAt', 'usedBy', 'circleId', 'deviceAssociationId',
          'updatedAt'
        ]);
    }

    function validPairingAssociationCreate(groupId, deviceId) {
      let pairingId = request.resource.data.pairingRequestId;
      let pairing = getAfter(pairingPath(pairingId));
      let ownerId = request.resource.data.ownerUserId;
      return isCircleManager(groupId) &&
        request.resource.data.keys().hasAll([
          'circleId', 'pairingRequestId', 'ownerUserId', 'installationId',
          'name', 'model', 'platform', 'pairingStatus', 'pairedAt',
          'lastSeenAt', 'lastHeartbeatAt', 'createdAt', 'updatedAt'
        ]) &&
        request.resource.data.keys().hasOnly([
          'circleId', 'pairingRequestId', 'ownerUserId', 'installationId',
          'name', 'model', 'platform', 'appVersion', 'pairingStatus',
          'pairedAt', 'lastSeenAt', 'lastHeartbeatAt', 'createdAt', 'updatedAt'
        ]) &&
        ownerId in group(groupId).data.memberIds &&
        deviceId == ownerId + '_' + request.resource.data.installationId &&
        request.resource.data.circleId == groupId &&
        request.resource.data.installationId.matches('^[A-Z2-9]{32}$') &&
        validDeviceName(request.resource.data.name) &&
        validDevicePlatform(request.resource.data.platform) &&
        request.resource.data.model is string &&
        request.resource.data.model.size() <= 100 &&
        (!('appVersion' in request.resource.data) ||
          (request.resource.data.appVersion is string &&
           request.resource.data.appVersion.size() <= 32)) &&
        request.resource.data.pairingStatus == 'paired' &&
        request.resource.data.pairedAt == request.time &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.lastHeartbeatAt == request.time &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(pairingPath(pairingId)) && pairing.data.status == 'used' &&
        pairing.data.circleId == groupId &&
        pairing.data.deviceAssociationId == deviceId &&
        pairing.data.ownerUserId == ownerId &&
        pairing.data.installationId == request.resource.data.installationId;
    }

    function validAssociationHeartbeat(groupId) {
      let installation = get(installationPath(
        request.auth.uid, resource.data.installationId
      ));
      return isMember(groupId) &&
        resource.data.ownerUserId == request.auth.uid &&
        resource.data.pairingStatus == 'paired' &&
        exists(installationPath(
          request.auth.uid, resource.data.installationId
        )) && installation.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'platform', 'appVersion', 'lastSeenAt', 'lastHeartbeatAt', 'updatedAt'
        ]) &&
        request.resource.data.platform == installation.data.platform &&
        request.resource.data.appVersion == installation.data.appVersion &&
        request.resource.data.lastSeenAt == request.time &&
        request.resource.data.lastHeartbeatAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.time >= resource.data.lastHeartbeatAt + duration.value(1, 'm');
    }

    function validAssociationRename(groupId) {
      let installation = getAfter(installationPath(
        request.auth.uid, resource.data.installationId
      ));
      return isMember(groupId) &&
        resource.data.ownerUserId == request.auth.uid &&
        resource.data.pairingStatus == 'paired' &&
        existsAfter(installationPath(
          request.auth.uid, resource.data.installationId
        )) && installation.data.status == 'active' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'updatedAt'
        ]) &&
        validDeviceName(request.resource.data.name) &&
        request.resource.data.name == installation.data.name &&
        request.resource.data.updatedAt == request.time;
    }

    function validAssociationRemoval(groupId) {
      return isMember(groupId) &&
        (resource.data.ownerUserId == request.auth.uid ||
          isCircleManager(groupId)) &&
        resource.data.pairingStatus == 'paired' &&
        request.resource.data.updatedAt == request.time &&
        ((request.resource.data.pairingStatus == 'revoked' &&
          request.resource.data.revokedAt == request.time &&
          request.resource.data.revokedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pairingStatus', 'revokedAt', 'revokedBy', 'updatedAt'
          ])) ||
         (request.resource.data.pairingStatus == 'unpaired' &&
          request.resource.data.removedAt == request.time &&
          request.resource.data.removedBy == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'pairingStatus', 'removedAt', 'removedBy', 'updatedAt'
          ])));
    }

    function validAssociationScreenTimeStatus(groupId) {
      return isMember(groupId) &&
        resource.data.ownerUserId == request.auth.uid &&
        resource.data.pairingStatus == 'paired' &&
        request.resource.data.permissions is map &&
        request.resource.data.permissions.screenTime == true &&
        request.resource.data.lastScreenTimeSyncAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'permissions', 'lastScreenTimeSyncAt', 'updatedAt'
        ]);
    }

    function validAssociationScreenTimePermission(groupId) {
      return isMember(groupId) &&
        resource.data.ownerUserId == request.auth.uid &&
        resource.data.pairingStatus == 'paired' &&
        request.resource.data.permissions is map &&
        request.resource.data.permissions.screenTime is bool &&
        request.resource.data.screenTimePermissionState in [
          'unknown', 'notGranted', 'granted', 'unavailable'
        ] &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'permissions', 'screenTimePermissionState', 'updatedAt'
        ]);
    }

    function validAssociationNotificationMetadata(groupId) {
      let installation = get(installationPath(
        request.auth.uid, resource.data.installationId
      ));
      return isMember(groupId) &&
        resource.data.ownerUserId == request.auth.uid &&
        resource.data.pairingStatus == 'paired' &&
        installation.data.status == 'active' &&
        request.resource.data.manufacturer == installation.data.manufacturer &&
        request.resource.data.model == installation.data.model &&
        request.resource.data.osVersion == installation.data.osVersion &&
        request.resource.data.androidApiLevel == installation.data.androidApiLevel &&
        request.resource.data.appVersion == installation.data.appVersion &&
        request.resource.data.appBuildNumber == installation.data.appBuildNumber &&
        request.resource.data.notificationPermissionState == installation.data.notificationPermissionState &&
        request.resource.data.notificationsEnabled == installation.data.notificationsEnabled &&
        request.resource.data.notificationCapable == installation.data.notificationCapable &&
        request.resource.data.pushUpdatedAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'manufacturer', 'model', 'osVersion', 'androidApiLevel',
          'appVersion', 'appBuildNumber', 'notificationPermissionState',
          'notificationsEnabled', 'notificationCapable', 'pushUpdatedAt',
          'updatedAt'
        ]);
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId &&
        validSelfProfile(userId);
      allow read: if signedIn() && request.auth.uid == userId;
      allow update: if signedIn() && request.auth.uid == userId &&
        validSelfProfile(userId);
      allow update: if validOwnerProfileCircleDeletion(userId);
      allow update: if signedIn() && approvedProfileUpdate(userId);
      allow delete: if false;

      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow update: if signedIn() && request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt']);
        allow delete: if signedIn() && request.auth.uid == userId &&
          resource.data.groupId is string &&
          ownerDeletingCircle(resource.data.groupId);
        allow create: if false;
      }

      match /checkIns/{checkInId} {
        allow create: if signedIn() && request.auth.uid == userId &&
          request.resource.data.userId == userId;
        allow read: if signedIn() && request.auth.uid == userId;
        allow update: if false;
        allow delete: if signedIn() && request.auth.uid == userId;
      }

      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && validInstallationCreate(userId, deviceId);
        allow update: if signedIn() &&
          (validInstallationHeartbeat(userId, deviceId) ||
           validInstallationRename(userId, deviceId) ||
           validInstallationRevoke(userId, deviceId) ||
           validPushRegistration(userId, deviceId) ||
           validPushDetach(userId, deviceId) ||
           validScreenTimePermissionUpdate(userId, deviceId) ||
           validScreenTimeSyncStatus(userId, deviceId));
        allow delete: if false;

        match /screenTimeDaily/{localDate} {
          allow read: if signedIn() && request.auth.uid == userId &&
            isPremiumUser(userId);
          allow create, update: if signedIn() &&
            isPremiumUser(userId) &&
            exists(installationPath(userId, deviceId)) &&
            get(installationPath(userId, deviceId)).data.status == 'active' &&
            validScreenTimeRecord(userId, deviceId, localDate);
          allow delete: if false;
        }
      }
    }

    match /groups/{groupId} {
      allow read: if signedIn() &&
        request.auth.uid in resource.data.memberIds &&
        resource.data.status == 'active';
      // Creation and membership entitlement mutations are trusted callable
      // transactions so clients cannot bypass plan limits.
      allow create: if false;
      allow update: if isCircleManager(groupId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'emergencyRecipientIds', 'updatedAt'
        ]) &&
        request.resource.data.emergencyRecipientIds.size() > 0 &&
        request.resource.data.emergencyRecipientIds.hasOnly(resource.data.memberIds);
      allow update: if false;
      // Lifecycle removal is a server transaction so member/profile references
      // cannot be left partially updated.
      allow delete: if false;

      match /memberships/{userId} {
        allow read: if isMember(groupId);
        allow create: if signedIn() &&
          request.resource.data.userId == userId &&
          request.resource.data.status == 'active' &&
          request.auth.uid == userId &&
          groupAfter(groupId).data.ownerId == request.auth.uid &&
          request.resource.data.circleRole == 'owner';
        allow create: if false;
        // Removal, leaving, and role changes remain trusted coordinated writes.
        // Approval is the narrowly validated getAfter-based client transaction.
        allow update: if false;
        allow update: if validOwnIdentitySync(userId);
        allow update: if validMembershipCircleDeletion(groupId);
        allow delete: if false;
      }

      match /joinRequests/{userId} {
        allow read: if signedIn() &&
          (request.auth.uid == userId || isCircleManager(groupId));
        allow create: if false;
        allow update: if false;
        allow update: if false;
        allow update: if false;
        allow update: if false;
        allow delete: if false;
      }

      // Kept temporarily for the current UI while registered-user
      // memberships replace manually-created member records.
      match /members/{memberId} {
        allow read: if isMember(groupId);
        allow create, update, delete: if isCircleManager(groupId);
      }

      match /devices/{deviceId} {
        allow read: if isMember(groupId) &&
          (resource.data.ownerUserId == request.auth.uid ||
           isCircleManager(groupId));
        allow create: if signedIn() &&
          validPairingAssociationCreate(groupId, deviceId);
        allow update: if signedIn() &&
          (deletionUnpairsDevice(groupId) ||
           validAssociationHeartbeat(groupId) ||
           validAssociationRename(groupId) ||
           validAssociationRemoval(groupId) ||
           validAssociationScreenTimeStatus(groupId) ||
           validAssociationScreenTimePermission(groupId) ||
           validAssociationNotificationMetadata(groupId));
        allow delete: if false;
      }

      match /screenTimeDaily/{recordId} {
        allow read: if isMember(groupId) && isPremiumUser(request.auth.uid);
        allow create, update: if signedIn() &&
          isPremiumUser(request.auth.uid) &&
          validCircleScreenTimeRecord(groupId, recordId);
        allow delete: if false;
      }

      match /progressDaily/{progressId} {
        allow read: if isMember(groupId) && isPremiumUser(request.auth.uid);
        allow create, update: if isMember(groupId) &&
          isPremiumUser(request.auth.uid) &&
          request.resource.data.userId == request.auth.uid;
        allow delete: if isOwner(groupId);
      }

      match /locationEvents/{eventId} {
        allow read: if isMember(groupId) && isPremiumUser(request.auth.uid);
        allow create: if isMember(groupId) &&
          isPremiumUser(request.auth.uid) &&
          request.resource.data.userId == request.auth.uid;
        allow update: if false;
        allow delete: if isOwner(groupId) ||
          (isMember(groupId) && resource.data.userId == request.auth.uid);
      }

      match /emergencies/{emergencyId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) &&
          request.resource.data.senderId == request.auth.uid &&
          request.resource.data.status == 'active' &&
          request.resource.data.recipientIds is list &&
          request.resource.data.recipientIds.size() > 0 &&
          request.resource.data.recipientIds.hasOnly(group(groupId).data.emergencyRecipientIds) &&
          request.resource.data.recipientIds.hasOnly(group(groupId).data.memberIds) &&
          !(request.auth.uid in request.resource.data.recipientIds);
        allow update: if isMember(groupId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acknowledgedById', 'acknowledgedByName',
            'acknowledgedAt', 'resolvedAt'
          ]);
        allow delete: if isOwner(groupId);
      }
    }

    match /circleInvites/{inviteId} {
      allow update: if signedIn() && deletionRevokesInvite(resource.data.circleId);
      allow get: if signedIn();
      allow list: if signedIn() && isCircleManager(resource.data.circleId);
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /devicePairingRequests/{pairingId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validPairingCreate(pairingId);
      allow update: if signedIn() &&
        ((request.auth.uid == resource.data.ownerUserId &&
          resource.data.status == 'active' &&
          request.resource.data.status == 'revoked' &&
          request.resource.data.revokedAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'revokedAt', 'updatedAt'
          ])) || validPairingUse(pairingId));
      allow delete: if false;
    }
  }
}
